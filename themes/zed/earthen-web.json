        "error.background": "#d47a5222",
        "error.border": "#d47a5266",
        "warning": "#dd9a55",
        "warning.background": "#dd9a5522",
        "warning.border": "#dd9a5555",
        "info": "#82b4d8",
        "info.background": "#82b4d822",
        "info.border": "#82b4d855",
        "hint": "#7fb8a2",
        "hint.background": "#7fb8a222",
        "hint.border": "#7fb8a255",
        "success": "#a3b56a",
        "success.background": "#a3b56a22",
        "success.border": "#a3b56a55",
        "conflict": "#dd9a55",
        "conflict.background": "#dd9a5522",
        "conflict.border": "#dd9a5555",
        "created": "#a3b56a",
        "created.background": "#a3b56a22",
        "created.border": "#a3b56a55",
        "deleted": "#d47a52",
        "deleted.background": "#d47a5222",
        "deleted.border": "#d47a5266",
        "modified": "#d9c078",
        "modified.background": "#d9c07822",
        "modified.border": "#d9c07855",
        "renamed": "#7fb8a2",
        "renamed.background": "#7fb8a222",
        "renamed.border": "#7fb8a255",
        "hidden": "#5c5342",
        "hidden.background": "#241f16",
        "hidden.border": "#2e281c",
        "ignored": "#5c5342",
        "ignored.background": "#241f16",
        "ignored.border": "#2e281c",
        "unreachable": "#d47a52",
        "unreachable.background": "#d47a5222",
        "unreachable.border": "#d47a5266",
        "predictive": "#5c5342",
        "predictive.background": "#241f16",
        "predictive.border": "#2e281c",

        "link_text.hover": "#7fb8a2",

        "players": [
          {
            "cursor": "#a3b56a",
            "background": "#a3b56a33",
            "selection": "#a3b56a33"
          },
          {
            "cursor": "#7fb8a2",
            "background": "#7fb8a233",
            "selection": "#7fb8a233"
          },
          {
            "cursor": "#d9c078",
            "background": "#d9c07833",
            "selection": "#d9c07833"
          },
          {
            "cursor": "#82b4d8",
            "background": "#82b4d833",
            "selection": "#82b4d833"
          },
          {
            "cursor": "#b394ad",
            "background": "#b394ad33",
            "selection": "#b394ad33"
          },
          {
            "cursor": "#dd9a55",
            "background": "#dd9a5533",
            "selection": "#dd9a5533"
          },
          {
            "cursor": "#d47a52",
            "background": "#d47a5233",
            "selection": "#d47a5233"
          }
        ],

        "syntax": {
          "attribute": { "color": "#d9c078" },
          "boolean": { "color": "#b394ad" },
          "comment": { "color": "#8c8170", "font_style": "italic" },
          "comment.doc": { "color": "#8c8170", "font_style": "italic" },
          "constant": { "color": "#d9c078" },
          "constructor": { "color": "#7fb8a2" },
          "embedded": { "color": "#f2ede3" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#a3b56a" },
          "function": { "color": "#a3b56a" },
          "function.decorator": { "color": "#d9c078" },
          "function.macro": { "color": "#7fb8a2" },
          "function.special": { "color": "#7fb8a2" },
          "hint": { "color": "#7fb8a2" },
          "identifier": { "color": "#f2ede3" },
          "keyword": { "color": "#7fb8a2", "font_weight": 600 },
          "keyword.control": { "color": "#7fb8a2", "font_weight": 600 },
          "keyword.control.import": { "color": "#7fb8a2", "font_style": "italic" },
          "keyword.directive": { "color": "#7fb8a2" },
          "keyword.modifier": { "color": "#7fb8a2" },
          "keyword.operator": { "color": "#7fb8a2" },
          "keyword.type": { "color": "#7fb8a2" },
          "label": { "color": "#d9c078" },
          "link": { "color": "#82b4d8", "underline": true },
          "link.uri": { "color": "#82b4d8", "underline": true },
          "link.text": { "color": "#7fb8a2" },
          "number": { "color": "#d9c078" },
          "operator": { "color": "#7fb8a2" },
          "predictive": { "color": "#5c5342", "font_style": "italic" },
          "preproc": { "color": "#b394ad" },
          "primary": { "color": "#f2ede3" },
          "punctuation": { "color": "#8c8170" },
          "punctuation.bracket": { "color": "#8c8170" },
          "punctuation.delimiter": { "color": "#8c8170" },
          "punctuation.list_marker": { "color": "#a3b56a" },
          "punctuation.special": { "color": "#7fb8a2" },
          "regexp": { "color": "#dd9a55" },
          "string": { "color": "#a3b56a" },
          "string.escape": { "color": "#7fb8a2" },
          "string.special": { "color": "#7fb8a2" },
          "string.special.symbol": { "color": "#7fb8a2" },
          "tag": { "color": "#7fb8a2" },
          "tag.attribute": { "color": "#d9c078" },
          "text": { "color": "#f2ede3" },
          "text.literal": { "color": "#a3b56a" },
          "title": { "color": "#d9c078", "font_weight": 700 },
          "type": { "color": "#82b4d8" },
          "type.builtin": { "color": "#82b4d8" },
          "type.interface": { "color": "#82b4d8" },
          "type.super": { "color": "#82b4d8" },
          "variable": { "color": "#f2ede3" },
          "variable.builtin": { "color": "#b394ad" },
          "variable.member": { "color": "#f2ede3" },
          "variable.parameter": { "color": "#dd9a55" },
          "variable.special": { "color": "#b394ad" }
        }
      }
    }
  ]
}
