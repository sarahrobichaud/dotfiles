{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "author": "zyriel",
  "name": "Earthen Web",
  "themes": [
    {
      "name": "Earthen Web Dark",
      "appearance": "dark",
      "style": {
        "accents": [
          "#a3b56a",
          "#7fb8a2",
          "#d9c078",
          "#82b4d8",
          "#b394ad",
          "#dd9a55",
          "#d47a52"
        ],

        "background": "#1b1812f2",
        "background.appearance": "blurred",
        "surface.background": "#241f16f0",
        "elevated_surface.background": "#2e281c",
        "element.background": "#2e281c",
        "element.hover": "#3a3222",
        "element.active": "#463d29",
        "element.selected": "#3a3222",
        "element.disabled": "#241f16",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#2e281c66",
        "ghost_element.active": "#2e281c99",
        "ghost_element.selected": "#3a3222",
        "ghost_element.disabled": "#00000000",

        "text": "#f2ede3",
        "text.muted": "#8c8170",
        "text.placeholder": "#5c5342",
        "text.disabled": "#5c5342",
        "text.accent": "#a3b56a",

        "icon": "#f2ede3",
        "icon.muted": "#8c8170",
        "icon.disabled": "#5c5342",
        "icon.placeholder": "#5c5342",
        "icon.accent": "#a3b56a",

        "border": "#463d29",
        "border.variant": "#2e281c",
        "border.focused": "#7fb8a2",
        "border.selected": "#a3b56a",
        "border.transparent": "#00000000",
        "border.disabled": "#2e281c",

        "panel.background": "#241f16d9",
        "panel.focused_border": "#7fb8a2",
        "panel.indent_guide": "#2e281c",
        "panel.indent_guide_hover": "#463d29",
        "panel.indent_guide_active": "#7fb8a2",

        "toolbar.background": "#241f16",
        "title_bar.background": "#1b1812",
