        "status_bar.background": "#1b1812",
        "tab_bar.background": "#1b1812",
        "tab.inactive_background": "#241f16",
        "tab.active_background": "#2e281c",

        "editor.background": "#241f16",
        "editor.foreground": "#f2ede3",
        "editor.gutter.background": "#241f16",
        "editor.subheader.background": "#241f16",
        "editor.active_line.background": "#2e281c88",
        "editor.highlighted_line.background": "#2e281c",
        "editor.line_number": "#5c5342",
        "editor.active_line_number": "#f2ede3",
        "editor.invisible": "#5c5342",
        "editor.indent_guide": "#3a3222",
        "editor.indent_guide_active": "#5c5342",
        "editor.wrap_guide": "#3a322244",
        "editor.active_wrap_guide": "#5c534288",
        "editor.document_highlight.read_background": "#2e281c88",
        "editor.document_highlight.write_background": "#3a322288",
        "editor.document_highlight.bracket_background": "#463d2988",

        "pane.focused_border": "#7fb8a2",
        "pane_group.border": "#2e281c",

        "scrollbar.track.background": "#241f16",
        "scrollbar.track.border": "#241f16",
        "scrollbar.thumb.background": "#463d29",
        "scrollbar.thumb.border": "#463d29",
        "scrollbar.thumb.hover_background": "#5c5342",

        "search.match_background": "#3a3222",
        "drop_target.background": "#7fb8a255",

        "terminal.background": "#1b1812",
        "terminal.foreground": "#f2ede3",
        "terminal.bright_foreground": "#ffffff",
        "terminal.dim_foreground": "#8c8170",

        "terminal.ansi.black": "#1b1812",
        "terminal.ansi.red": "#d47a52",
        "terminal.ansi.green": "#a3b56a",
        "terminal.ansi.yellow": "#d9c078",
        "terminal.ansi.blue": "#82b4d8",
        "terminal.ansi.magenta": "#b394ad",
        "terminal.ansi.cyan": "#7fb8a2",
        "terminal.ansi.white": "#f2ede3",
        "terminal.ansi.bright_black": "#5c5342",
        "terminal.ansi.bright_red": "#e89a78",
        "terminal.ansi.bright_green": "#bcd18c",
        "terminal.ansi.bright_yellow": "#e8d498",
        "terminal.ansi.bright_blue": "#a6cce8",
        "terminal.ansi.bright_magenta": "#c9b0c4",
        "terminal.ansi.bright_cyan": "#9ccbb8",
        "terminal.ansi.bright_white": "#ffffff",
        "terminal.ansi.dim_black": "#241f16",
        "terminal.ansi.dim_red": "#9a5236",
        "terminal.ansi.dim_green": "#5c6e3a",
        "terminal.ansi.dim_yellow": "#8f7a3c",
        "terminal.ansi.dim_blue": "#4a7494",
        "terminal.ansi.dim_magenta": "#74586e",
        "terminal.ansi.dim_cyan": "#4a7a68",
        "terminal.ansi.dim_white": "#8c8170",

